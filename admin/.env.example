# Copie este arquivo para .env.local e preencha (o .env.local nunca vai para o Git).
# Supabase > Project Settings > API (ou "Connect"): URL do projeto e a chave publicável (publishable/anon).
# NUNCA coloque aqui a chave secreta / service_role.
VITE_SUPABASE_URL=https://projeto-exemplo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO_NAO_E_CREDENCIAL
# Necessários somente para npm run semear / npm run publicar na raiz.
EDITOR_EMAIL=
EDITOR_PASSWORD=
